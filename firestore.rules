rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper primitives
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isVerifiedOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        request.auth.token.email == 'kushalsohagpure5@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Validation blueprints
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'lastLoginAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'photoURL', 'providerId', 'createdAt', 'lastLoginAt'])
        && data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128
        && data.email is string && data.email.size() > 0 && data.email.size() <= 200
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 150))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1000))
        && (!('providerId' in data) || (data.providerId is string && data.providerId.size() <= 64))
        && (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64))
        && data.lastLoginAt is string && data.lastLoginAt.size() <= 64;
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['id', 'name', 'price', 'stock'])
        && data.keys().hasOnly(['id', 'name', 'characterId', 'characterName', 'price', 'category', 'ageRange', 'stock'])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.price is number && data.price >= 0 && data.price <= 1000000
        && data.stock is number && data.stock >= 0 && data.stock <= 10000
        && (!('characterId' in data) || (data.characterId is string && data.characterId.size() <= 64))
        && (!('characterName' in data) || (data.characterName is string && data.characterName.size() <= 100))
        && (!('category' in data) || (data.category is string && data.category.size() <= 100))
        && (!('ageRange' in data) || (data.ageRange is string && data.ageRange.size() <= 50));
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['id', 'userId', 'customerName', 'email', 'total', 'status'])
        && data.keys().hasOnly([
          'id', 'userId', 'date', 'items', 'subtotal', 'discount', 'shipping',
          'total', 'customerName', 'email', 'phone', 'address', 'city',
          'pincode', 'paymentMethod', 'isGift', 'giftMessage', 'status'
        ])
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128
        && data.customerName is string && data.customerName.size() > 0 && data.customerName.size() <= 200
        && data.email is string && data.email.size() > 0 && data.email.size() <= 200
        && data.total is number && data.total >= 0
        && data.status is string && data.status in ['Confirmed', 'Dispatched', 'Delivered']
        && (!('date' in data) || (data.date is string && data.date.size() <= 64))
        && (!('subtotal' in data) || (data.subtotal is number && data.subtotal >= 0))
        && (!('discount' in data) || (data.discount is number && data.discount >= 0))
        && (!('shipping' in data) || (data.shipping is number && data.shipping >= 0))
        && (!('isGift' in data) || data.isGift is bool)
        && (!('items' in data) || (data.items is list && data.items.size() <= 50 && (data.items.size() == 0 || data.items[0] is map)))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 50))
        && (!('address' in data) || (data.address is string && data.address.size() <= 500))
        && (!('city' in data) || (data.city is string && data.city.size() <= 100))
        && (!('pincode' in data) || (data.pincode is string && data.pincode.size() <= 20))
        && (!('paymentMethod' in data) || (data.paymentMethod is string && data.paymentMethod.size() <= 100))
        && (!('giftMessage' in data) || (data.giftMessage is string && data.giftMessage.size() <= 500));
    }

    function isValidUserPreference(data) {
      return data.keys().hasAll(['userId', 'storyInterests', 'valuesToEncourage', 'onboardingCompleted'])
        && data.keys().hasOnly(['userId', 'storyInterests', 'valuesToEncourage', 'childAge', 'onboardingCompleted', 'updatedAt'])
        && data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128
        && data.storyInterests is list && data.storyInterests.size() <= 20 && (data.storyInterests.size() == 0 || data.storyInterests[0] is string)
        && data.valuesToEncourage is list && data.valuesToEncourage.size() <= 24 && (data.valuesToEncourage.size() == 0 || data.valuesToEncourage[0] is string)
        && data.onboardingCompleted is bool
        && (!('childAge' in data) || (data.childAge is string && data.childAge.size() <= 50))
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidWishlist(data) {
      return data.keys().hasAll(['userId', 'productIds'])
        && data.keys().hasOnly(['userId', 'productIds', 'updatedAt'])
        && data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128
        && data.productIds is list && data.productIds.size() <= 100 && (data.productIds.size() == 0 || data.productIds[0] is string)
        && (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isVerifiedOwner(userId)
                    && isValidId(userId)
                    && isValidUser(incoming())
                    && incoming().uid == request.auth.uid;
      allow update: if isVerifiedOwner(userId)
                    && isValidId(userId)
                    && isValidUser(incoming())
                    && incoming().uid == existing().uid
                    && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'photoURL', 'providerId', 'lastLoginAt']);
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if isValidId(productId) && isValidProduct(incoming());
      allow update: if isValidId(productId)
                    && isValidProduct(incoming())
                    && (
                      isAdmin() ||
                      incoming().diff(existing()).affectedKeys().hasOnly(['stock'])
                    );
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow get: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidId(orderId)
                    && isValidOrder(incoming())
                    && (
                      (isSignedIn() && incoming().userId == request.auth.uid) ||
                      (!isSignedIn() && incoming().userId == 'guest')
                    );
      allow update, delete: if isAdmin();
    }

    match /user_preferences/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isVerifiedOwner(userId)
                            && isValidId(userId)
                            && isValidUserPreference(incoming())
                            && incoming().userId == request.auth.uid;
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /wishlists/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isVerifiedOwner(userId)
                            && isValidId(userId)
                            && isValidWishlist(incoming())
                            && incoming().userId == request.auth.uid;
      allow delete: if isOwner(userId) || isAdmin();
    }
  }
}
